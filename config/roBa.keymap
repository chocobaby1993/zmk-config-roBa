#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        macro0: macro0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp INT_MUHENKAN &kp LS(Q) &kp LS(Z) &kp U &kp G &kp X &kp NUMBER_2 &kp J &kp I &kp R &kp LS(R)>;
            label = "MACRO0";
        };

        macro1: macro1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "MACRO1";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W    &kp E         &kp R                             &kp T                                                                         &kp Y        &kp U  &lt 5 I    &kp O    &kp P
&mt LCTRL A       &kp S    &kp D         &lt 2 F                           &lt 3 G      &none                                 &lt 6 LANG_ZENKAKUHANKAKU  &kp H        &kp J  &kp K      &kp L    &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X    &kp C         &kp V                             &kp B        &kp COLON                             &kp SEMICOLON              &kp N        &kp M  &kp COMMA  &kp DOT  &mkp MB1
&kp LEFT_SHIFT    &kp TAB  &kp LEFT_WIN  &lt_to_layer_0 6 INTERNATIONAL_5  &lt 1 SPACE  &lt_to_layer_0 3 INTERNATIONAL_4      &kp BACKSPACE              &lt 2 ENTER                             &mkp MB2
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            bindings = <
&kp LC(W)       &kp F2          &kp F3  &kp F4    &kp F5                         &kp LC(X)  &kp F7              &kp LC(PAGE_UP)     &kp LC(PAGE_DOWN)    &kp LC(LS(KP_NUMBER_1))
&kp LEFT_SHIFT  &kp LC(T)       &kp F6  &mkp MB1  &kp F12  &trans      &kp HOME  &kp LC(C)  &kp LC(LS(TAB))     &kp LG(UP_ARROW)    &kp LC(TAB)          &kp LC(KP_NUMBER_1)
&kp LC(LS(C))   &trans          &trans  &mkp MB2  &trans   &trans      &kp END   &kp LC(V)  &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &kp EXCLAMATION
&trans          &kp KP_NUMLOCK  &trans  &trans    &trans   &trans      &trans    &trans                                                                  &kp QUESTION
            >;
        };

        NUM {
            bindings = <
&kp DOLLAR           &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LA(UP_ARROW)                            &kp LC(LS(O))  &kp LC(LG(LS(C)))  &kp HOME        &kp LG(L)        &kp ESC
&kp LEFT_SHIFT       &kp LEFT_ALT       &kp UNDERSCORE        &kp AMPERSAND          &kp LA(LEFT_ARROW)   &trans      &trans     &kp LC(LS(N))  &mkp MB1           &kp UP_ARROW    &mkp MB2         &kp COLON
&kp AT_SIGN          &kp PERCENT        &kp SQT               &kp HASH               &kp LA(RIGHT_ARROW)  &trans      &trans     &kp LC(N)      &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp SEMICOLON
&kp LC(LS(KP_PLUS))  &trans             &kp LA(F4)            &kp LEFT_SHIFT         &kp TAB              &trans      &kp RCTRL  &trans                                                             &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&macro0         &kp LC(LS(ASTERISK))    &kp PLUS        &kp LC(MINUS)            &kp EQUAL                      &kp PRINTSCREEN  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp SLASH
&kp HOME        &kp LS(LC(R))           &kp DOWN_ARROW  &kp LG(NUMBER_4)         &kp RCTRL  &trans      &trans  &kp PERIOD       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp COMMA
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans     &trans      &trans  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp COMMA
&trans          &trans                  &trans          &trans                   &trans     &trans      &trans  &trans                                                              &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
